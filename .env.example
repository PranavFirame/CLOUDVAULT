# CloudVault Local Environment Configuration

# Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Connection URL
DATABASE_URL=postgresql://cloudvault:cloudvault_secure_password_dev@localhost:5432/cloudvault?schema=public

# PostgreSQL Container Credentials (used by Docker Compose)
POSTGRES_DB=cloudvault
POSTGRES_USER=cloudvault
POSTGRES_PASSWORD=cloudvault_secure_password_dev

# Redis Connection URL
REDIS_URL=redis://:cloudvault_redis_secret@localhost:6379

# Redis Container Password (used by Docker Compose)
REDIS_PASSWORD=cloudvault_redis_secret

# Session Secret (High-entropy secret used for signing session cookies)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=e7d6d50e8a9f24b4c731e50882e98715a31b40974dc3e75e921da849204bf162

# Local Encrypted Object Storage Directory (Absolute or relative path)
LOCAL_STORAGE_PATH=./data/objects

# Upload and Storage Limits
# 100 MiB per file limit = 104857600 bytes
MAX_UPLOAD_SIZE_BYTES=104857600

# Total user quota limit (e.g., 5 GiB) = 5368709120 bytes
MAX_STORAGE_BYTES=5368709120
